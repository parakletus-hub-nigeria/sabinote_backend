    "/api/v1/curriculum/releases": {
      "get": {
        "description": "Browse published and draft curriculum releases filtered optionally by stage and status.",
        "operationId": "CurriculumController_getReleases",
        "parameters": [
          {
            "name": "stage",
            "required": false,
            "in": "query",
            "description": "Filter curriculum releases by educational stage",
            "schema": {
              "type": "string",
              "enum": [
                "early_years",
                "primary",
                "junior_secondary",
                "senior_secondary"
              ]
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Filter curriculum releases by status (draft, published, superseded, archived)",
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "published",
                "superseded",
                "archived"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching curriculum releases."
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Browse curriculum releases",
        "tags": [
          "Curriculum"
        ]
      },
      "post": {
        "description": "Creates a new versioned release entity (e.g. NERDC-JSS-2025.1, SABINOTE-ECE-2025.1).",
        "operationId": "CurriculumController_createRelease",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCurriculumReleaseDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Curriculum release successfully created."
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Create a new curriculum release (Admin)",
        "tags": [
          "Curriculum"
        ]
      }
    },
    "/api/v1/curriculum/releases/{id}/units": {
      "post": {
        "description": "Bulk imports or upserts canonical curriculum units for a specific release ID.",
        "operationId": "CurriculumController_seedUnits",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Curriculum Release UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeedCurriculumUnitsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Units imported/upserted successfully."
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Import and seed versioned units (Admin)",
        "tags": [
          "Curriculum"
        ]
      },
      "get": {
        "description": "Query units belonging to a specific release filtered by classLevel, subject, term, and week.",
        "operationId": "CurriculumController_getUnits",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Curriculum Release UUID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "classLevel",
            "required": false,
            "in": "query",
            "description": "Filter by class level",
            "schema": {
              "example": "JSS 1",
              "type": "string"
            }
          },
          {
            "name": "subject",
            "required": false,
            "in": "query",
            "description": "Filter by subject name",
            "schema": {
              "example": "Mathematics",
              "type": "string"
            }
          },
          {
            "name": "term",
            "required": false,
            "in": "query",
            "description": "Filter by academic term (1, 2, 3)",
            "schema": {
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "week",
            "required": false,
            "in": "query",
            "description": "Filter by week number (1 to 13)",
            "schema": {
              "example": 1,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching curriculum units."
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Query versioned units for a release",
        "tags": [
          "Curriculum"
        ]
      }
    },
