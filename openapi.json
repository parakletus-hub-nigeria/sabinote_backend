  "info": {
    "title": "SabiNote API",
    "description": "SabiNote Education Platform API — Grounded Nigerian Lesson & Curriculum Engine",
    "version": "2.0.0-baseline",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": ""
    },
    {
      "name": "Users",
      "description": ""
    },
    {
      "name": "Curriculum",
      "description": ""
    },
    {
      "name": "Generation",
      "description": ""
    },
    {
      "name": "Notes",
      "description": ""
    },
    {
      "name": "Wallet",
      "description": ""
    },
    {
      "name": "Resources",
      "description": ""
    },
    {
      "name": "Admin",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "Authorization",
        "in": "header"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateSettingsDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateTopupDto": {
        "type": "object",
        "properties": {}
      },
      "CreateCurriculumReleaseDto": {
        "type": "object",
        "properties": {
          "releaseTag": {
            "type": "string",
            "example": "NERDC-JSS-2025.1",
            "description": "Unique release tag"
          },
          "title": {
            "type": "string",
            "example": "NERDC Junior Secondary Curriculum 2025.1",
            "description": "Descriptive title of the curriculum release"
          },
          "stage": {
            "type": "string",
            "enum": [
              "early_years",
              "primary",
              "junior_secondary",
              "senior_secondary"
            ],
            "example": "junior_secondary",
            "description": "Curriculum educational stage"
          },
          "version": {
            "type": "string",
            "example": "2025.1",
            "description": "Semantic version or year edition tag"
          },
          "sourceCode": {
            "type": "string",
            "example": "NERDC",
            "description": "Curriculum source authority code (e.g., NERDC, NAPPS, LEGACY)",
            "default": "NERDC"
          },
          "sourceId": {
            "type": "string",
            "description": "Direct CurriculumSource UUID if known"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "superseded",
              "archived"
            ],
            "default": "draft",
            "description": "Release publishing status"
          },
          "checksum": {
            "type": "string",
            "description": "Checksum hash for provenance and tamper verification"
          },
          "metadata": {
            "type": "object",
            "description": "Extensible JSON metadata"
          }
        },
        "required": [
          "releaseTag",
          "title",
          "stage",
          "version"
        ]
      },
      "CurriculumUnitInputDto": {
        "type": "object",
        "properties": {
          "classLevel": {
            "type": "string",
            "example": "JSS 1",
            "description": "Class level designation"
          },
          "subject": {
            "type": "string",
            "example": "Mathematics",
            "description": "Subject name"
          },
          "term": {
            "type": "number",
            "example": 1,
            "description": "Academic term (1, 2, or 3)"
          },
          "week": {
            "type": "number",
            "example": 1,
            "description": "Curriculum week number (1 to 13)"
          },
          "topic": {
            "type": "string",
            "example": "Whole Numbers",
            "description": "Main topic of instruction"
          },
          "subTopics": {
            "description": "Subtopics covered in this unit",
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "learningObjectives": {
            "description": "Measurable student learning objectives",
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "competencies": {
            "description": "Key competencies developed (e.g. Critical Thinking, Numeracy)",
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "teachingActivities": {
            "type": "string",
            "description": "Detailed teacher and student learning activities"
          },
          "teachingAids": {
            "type": "string",
            "description": "Recommended teaching aids and materials"
          },
          "evaluationGuide": {
            "type": "string",
            "description": "Evaluation guide and assessment questions"
          },
          "referenceMaterials": {
            "description": "Recommended textbooks and reference materials",
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object",
            "description": "Arbitrary structured metadata"
          }
        },
        "required": [
          "classLevel",
          "subject",
          "term",
          "week",
          "topic"
        ]
      },
      "SeedCurriculumUnitsDto": {
        "type": "object",
        "properties": {
          "units": {
            "description": "Array of versioned curriculum units to import or seed",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurriculumUnitInputDto"
            }
          }
        },
        "required": [
          "units"
        ]
      },
      "SeedCurriculumDto": {
        "type": "object",
        "properties": {}
      },
      "SeedGeneralCurriculumDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateNoteDto": {
        "type": "object",
        "properties": {}
      },
      "GeneratePlanDto": {
        "type": "object",
        "properties": {
          "curriculumUnitId": {
            "type": "string",
            "description": "ID from versioned CurriculumUnit (v2 release-first)"
          },
          "curriculumWeekId": {
            "type": "string",
            "description": "ID from CurriculumWeek (state-specific)"
          },
          "generalCurriculumId": {
            "type": "string",
            "description": "ID from GeneralCurriculum (legacy national fallback)"
          },
          "durationMinutes": {
            "type": "number",
            "example": 45,
            "description": "Duration of lesson in minutes"
          },
          "resourceId": {
            "type": "string",
            "description": "Optional uploaded resource ID for RAG grounding"
          }
        },
        "required": [
          "durationMinutes"
        ]
      },
      "GenerateNoteDto": {
        "type": "object",
        "properties": {}
      },
      "RegenerateDto": {
        "type": "object",
        "properties": {}
      },
      "CreditWalletDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}